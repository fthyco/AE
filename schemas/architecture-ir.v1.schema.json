{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fthyco/AE/blob/main/schemas/architecture-ir.v1.schema.json",
  "title": "MAGG SAE Architecture IR v1.0",
  "type": "object",
  "required": ["schema_version", "extractor_version", "entrypoint", "nodes", "edges", "unresolved"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "extractor_version": {"type": "string"},
    "entrypoint": {"type": ["string", "null"]},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "unresolved": {"type": "array", "items": {"type": "object", "required": ["kind", "path", "reason", "source_refs"], "properties": {"kind": {"type": "string"}, "path": {"type": "string"}, "reason": {"type": "string"}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/span"}}}, "additionalProperties": true}}
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["path", "start_byte", "end_byte", "start_line", "start_column", "end_line", "end_column", "precision"],
      "properties": {
        "path": {"type": "string"}, "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 0},
        "start_line": {"type": "integer", "minimum": 1}, "start_column": {"type": "integer", "minimum": 0},
        "end_line": {"type": "integer", "minimum": 1}, "end_column": {"type": "integer", "minimum": 0},
        "precision": {"enum": ["exact", "enclosing", "file"]}
      }, "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "attributes", "source_refs", "evidence_class", "resolution"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "kind": {"type": "string"},
        "attributes": {"type": "object"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
        "evidence_class": {"enum": ["explicit", "derived"]},
        "resolution": {"enum": ["resolved", "conditional", "ambiguous", "unresolved"]},
        "analysis_rule": {"type": "string"}
      }, "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "relation", "evidence_class", "source_refs"],
      "properties": {
        "id": {"type": "string"}, "source": {"type": "string"}, "target": {"type": "string"},
        "relation": {"type": "string"}, "evidence_class": {"enum": ["explicit", "derived"]},
        "analysis_rule": {"type": "string"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
        "attributes": {"type": "object"}
      }, "additionalProperties": false
    }
  }
}
