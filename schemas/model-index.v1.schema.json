{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fthyco/AE/blob/main/schemas/model-index.v1.schema.json",
  "title": "AE SAE Entrypoint Model Index v1.0",
  "type": "object",
  "required": ["schema_version", "entrypoint", "root_definition_id", "status", "modules", "unresolved", "limitations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "entrypoint": {"type": ["string", "null"]},
    "root_definition_id": {"type": ["string", "null"]},
    "status": {"enum": ["no_entrypoint", "unresolved", "unsupported_entrypoint", "indexed"]},
    "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}},
    "unresolved": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "factory_specialization": {"type": "object", "required": ["factory_definition_id", "factory_configuration_id", "model_definition_id", "block_definition_id", "block_type", "stage_counts", "total_blocks", "stages", "scope", "resolution"], "properties": {"factory_definition_id": {"type": "string"}, "factory_configuration_id": {"type": "string"}, "model_definition_id": {"type": "string"}, "block_definition_id": {"type": "string"}, "block_type": {"type": "string"}, "stage_counts": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "total_blocks": {"type": "integer", "minimum": 1}, "stages": {"type": "array", "items": {"type": "object"}}, "scope": {"const": "static_constructor_blueprint"}, "resolution": {"const": "conditional"}}, "additionalProperties": false}
  },
  "$defs": {
    "span": {"type": "object", "required": ["path", "start_byte", "end_byte", "precision"]},
    "component": {
      "type": "object",
      "required": ["construction_site_id", "layer_spec_ids", "owner_expression", "declared_type", "target_definition_id", "source_refs"],
      "properties": {
        "construction_site_id": {"type": "string"},
        "layer_spec_ids": {"type": "array", "items": {"type": "string"}},
        "owner_expression": {"type": "string"},
        "declared_type": {"type": "string"},
        "target_definition_id": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      },
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "required": ["call_site_id", "callee_expression", "module_construction_site_ids", "local_definition_ids", "source_refs"],
      "properties": {
        "call_site_id": {"type": "string"},
        "callee_expression": {"type": "string"},
        "module_construction_site_ids": {"type": "array", "items": {"type": "string"}},
        "local_definition_ids": {"type": "array", "items": {"type": "string"}},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["operation_site_id", "operator", "source_refs"],
      "properties": {
        "operation_site_id": {"type": "string"},
        "operator": {"type": "string"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      },
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "required": ["definition_id", "qualname", "source_refs", "forward_method_id", "components", "forward_calls", "forward_operations", "forward_relation_ids"],
      "properties": {
        "definition_id": {"type": "string"},
        "qualname": {"type": "string"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "forward_method_id": {"type": ["string", "null"]},
        "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
        "forward_calls": {"type": "array", "items": {"$ref": "#/$defs/call"}},
        "forward_operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "forward_relation_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
